# Copy to .env (local) — set the same keys in PXXL dashboard Secrets for production.
# Spotify Client Credentials (display-only search, no user OAuth needed for api.py).
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Single primary origin (PXXL start detects this for CORS).
FRONTEND_URL=https://themoodmix.vercel.app
# Optional comma-separated extra origins (e.g. previews, localhost).
# FRONTEND_URLS=http://localhost:3000,https://themoodmix-xyz.vercel.app
# Set to 0 to disable the built-in production-origin fallback in api.py.
# ALLOW_PROD_FRONTEND=1
# Spotify search market (ISO country code).
# SPOTIFY_MARKET=US
# Per-IP limit on /predict/* requests per minute (0 disables).
# RATE_LIMIT_PER_MIN=30
# Seconds to cache Spotify search results per mood.
# TRACK_CACHE_TTL=3600
# LOG_LEVEL=INFO
# Mood-correction feedback (SQLite). Use a persistent volume path in production.
# FEEDBACK_DB=/data/feedback.sqlite3
# Bearer token required for GET /feedback/export (unset = export disabled).
# FEEDBACK_EXPORT_TOKEN=
# Interactive API docs at /docs (off by default; keep off in production).
# ENABLE_DOCS=1
# Memory: the API holds both models (~525 MB RSS). Give it at least 1 GB RAM.
