# Production backend image for PXXL (FastAPI in api.py).
# The legacy Streamlit Dockerfile (Dockerfile) is left untouched for HF Spaces.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --upgrade pip setuptools wheel && pip install -r requirements-api.txt

COPY scripts/ ./scripts/
RUN python scripts/fetch_models.py

COPY api.py ./
COPY src/ ./src/
COPY config/ ./config/
COPY models/ ./models/

# PXXL injects $PORT and routes to it; default to 8000 for local runs.
EXPOSE 8000

CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips=* --timeout-keep-alive 5"]
